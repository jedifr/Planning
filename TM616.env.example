# Copier en `TM616.env` (même dossier que docker-compose.yml) — ce fichier n'est jamais versionné.
# Lecture automatique de la pointeuse TimeMoto TM-616 (service zk-sync).
# Clé partagée : générer avec   openssl rand -hex 24
DEVICE_SYNC_KEY=
# Adresse de la pointeuse sur le réseau de l'atelier
ZK_IP=192.168.1.37
#ZK_PORT=4370
#ZK_COMMKEY=0
# Valeur de départ seulement : la fréquence se règle ensuite dans Planning (page Présence → ⏱ TimeMoto → « Fréquence de lecture »).
#SYNC_INTERVAL=300
#SYNC_DAYS=3
